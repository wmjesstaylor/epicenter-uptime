#!/bin/bash
# Refreshes the local copy of Cloudflare's published IP ranges and regenerates
# anything that depends on them.
#
#   cloudflare-ips-refresh            # fetch, validate, apply if changed
#   cloudflare-ips-refresh --force    # apply even if unchanged
#
# WHY THIS IS ONE SHARED LIST. Two separate things on this host need to know
# "which addresses are Cloudflare":
#
#   1. nginx real_ip  — which peers are TRUSTED to state the real client IP in
#                       CF-Connecting-IP.
#   2. the firewall   — which peers may reach ports 80/443 at all.
#
# Two hand-maintained copies of the same list is how they drift, and a drifted
# list is not a cosmetic problem in either place. Too narrow in nginx and real
# visitors get logged as Cloudflare; too narrow in the firewall and the site
# goes dark for everyone behind the missing range.
#
# WHY THE VALIDATION IS SO FUSSY. This script writes a file that decides who can
# reach the site. If Cloudflare serves an error page, a captive portal
# intercepts the request, or DNS is having one of its moments (see the probe's
# retry comment — the resolvers on these droplets are measurably flaky), a naive
# fetch writes garbage and the firewall step later locks the world out. So:
# fetch to a temp file, parse every line as a CIDR, demand a plausible count,
# and on ANY doubt keep the existing list and exit non-zero. Refusing to update
# is always safer than updating to nonsense.
set -uo pipefail

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

DEST_DIR=/etc/cloudflare
V4="$DEST_DIR/ips-v4"
V6="$DEST_DIR/ips-v6"
NGINX_CONF=/etc/nginx/conf.d/cloudflare-realip.conf

# Sanity floors. Cloudflare has published ~15 IPv4 and ~7 IPv6 ranges for years.
# If we get materially fewer, something answered that was not Cloudflare.
MIN_V4=10
MIN_V6=4

log() { printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*"; }
die() { log "ERROR: $*"; exit 1; }

command -v curl >/dev/null 2>&1 || die "curl not found"

mkdir -p "$DEST_DIR" || die "cannot create $DEST_DIR"

TMP=$(mktemp -d) || die "mktemp failed"
trap 'rm -rf "$TMP"' EXIT

# -4: these droplets have no IPv6 route (verified 2026-09-02 across all three).
# Without it, curl also resolves AAAA it cannot use — see the probe's -4 comment.
fetch() {
    local url="$1" out="$2" rc
    curl -4 -fsS --max-time 20 --retry 2 --retry-delay 3 "$url" -o "$out"
    rc=$?
    [ "$rc" -eq 0 ] || { log "fetch failed for $url (curl exit $rc)"; return 1; }
    [ -s "$out" ] || { log "fetch returned an empty body for $url"; return 1; }

    # Cloudflare serves these lists with NO trailing newline, and `while read`
    # discards a final unterminated line. That silently dropped the LAST range
    # of each list on 2026-09-02 — 131.0.72.0/22 and 2c0f:f248::/32 — so the
    # generated nginx trust list held 20 of 22 ranges and nobody would have
    # noticed from the output, which cheerfully reported success.
    #
    # Harmless-looking here, an outage one script later: those are live edge
    # ranges, and the firewall built from this same list would have refused
    # every visitor routed through them. Normalise once, at the source, so
    # every consumer of these files gets all of the data.
    [ "$(tail -c1 "$out" | wc -l)" -eq 0 ] && printf '\n' >> "$out"
    return 0
}

# Every line must be a CIDR and nothing else. An HTML error page fails here.
validate() {
    local file="$1" family="$2" min="$3" count=0 line
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        [ -z "$line" ] && continue
        if [ "$family" = "v4" ]; then
            [[ "$line" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || {
                log "not a v4 CIDR: '$line'"; return 1; }
        else
            [[ "$line" =~ ^[0-9a-fA-F:]+/[0-9]{1,3}$ ]] || {
                log "not a v6 CIDR: '$line'"; return 1; }
        fi
        count=$((count + 1))
    done < "$file"
    [ "$count" -ge "$min" ] || { log "only $count $family ranges, expected >= $min"; return 1; }
    log "validated $count $family ranges"
    return 0
}

fetch https://www.cloudflare.com/ips-v4 "$TMP/v4" || die "could not fetch IPv4 ranges — keeping existing list"
fetch https://www.cloudflare.com/ips-v6 "$TMP/v6" || die "could not fetch IPv6 ranges — keeping existing list"

validate "$TMP/v4" v4 "$MIN_V4" || die "IPv4 list failed validation — keeping existing list"
validate "$TMP/v6" v6 "$MIN_V6" || die "IPv6 list failed validation — keeping existing list"

CHANGED=0
if [ ! -f "$V4" ] || ! cmp -s "$TMP/v4" "$V4"; then CHANGED=1; fi
if [ ! -f "$V6" ] || ! cmp -s "$TMP/v6" "$V6"; then CHANGED=1; fi

if [ "$CHANGED" -eq 0 ] && [ "$FORCE" -eq 0 ]; then
    log "Cloudflare ranges unchanged — nothing to do"
    exit 0
fi

# Keep the previous list. If a future change ever breaks reachability, the
# question "what did it look like before?" should not need the internet.
for f in "$V4" "$V6"; do
    [ -f "$f" ] && cp -a "$f" "${f}.prev"
done

install -m 0644 "$TMP/v4" "$V4"
install -m 0644 "$TMP/v6" "$V6"
log "wrote $V4 and $V6"

# ── nginx real_ip ─────────────────────────────────────────────────────
# set_real_ip_from is a TRUST list, not a filter: nginx honours
# CF-Connecting-IP only when the immediate peer is one of these. That is what
# stops a direct-to-origin visitor forging the header and getting an innocent
# third party banned. Anyone connecting from outside these ranges is logged
# with their own address, which is exactly what we want given the origin is
# reachable directly.
if [ -d /etc/nginx ]; then
    {
        echo "# Generated by cloudflare-ips-refresh — do not edit by hand."
        echo "# Regenerate: sudo cloudflare-ips-refresh --force"
        echo "# Last updated: $(date -u '+%Y-%m-%d %H:%M UTC')"
        echo
        while IFS= read -r cidr || [ -n "$cidr" ]; do
            [ -n "$cidr" ] && echo "set_real_ip_from ${cidr%$'\r'};"
        done < "$V4"
        while IFS= read -r cidr || [ -n "$cidr" ]; do
            [ -n "$cidr" ] && echo "set_real_ip_from ${cidr%$'\r'};"
        done < "$V6"
        echo
        echo "real_ip_header CF-Connecting-IP;"
        # Only one proxy hop here (Cloudflare -> nginx), so recursion buys
        # nothing and would trust a chain we do not control.
        echo "real_ip_recursive off;"
    } > "$TMP/nginx.conf"

    # Assert every range made it into the config. The trailing-newline bug was
    # invisible precisely because the script reported success while emitting 20
    # of 22 ranges — the output looked identical to a correct run. Anything that
    # silently drops entries from a trust list must be caught by counting, not
    # by reading the log. Cheap, and it fails closed.
    WANT=$(( $(grep -c . "$V4") + $(grep -c . "$V6") ))
    GOT=$(grep -c '^set_real_ip_from ' "$TMP/nginx.conf")
    if [ "$WANT" -ne "$GOT" ]; then
        die "generated $GOT set_real_ip_from directives but have $WANT ranges — refusing to install a partial trust list"
    fi
    log "trust list complete: $GOT of $WANT ranges"

    if [ -f "$NGINX_CONF" ] && cmp -s "$TMP/nginx.conf" "$NGINX_CONF" && [ "$FORCE" -eq 0 ]; then
        log "nginx real_ip config already current"
    else
        [ -f "$NGINX_CONF" ] && cp -a "$NGINX_CONF" "${NGINX_CONF}.prev"
        install -m 0644 "$TMP/nginx.conf" "$NGINX_CONF"
        if nginx -t 2>/dev/null; then
            systemctl reload nginx && log "nginx reloaded with updated real_ip ranges"
        else
            # A broken nginx config is a down site. Put back what worked.
            log "nginx -t FAILED — reverting real_ip config"
            if [ -f "${NGINX_CONF}.prev" ]; then
                cp -a "${NGINX_CONF}.prev" "$NGINX_CONF"
            else
                rm -f "$NGINX_CONF"
            fi
            nginx -t >/dev/null 2>&1 && systemctl reload nginx
            die "nginx config test failed; real_ip left unchanged"
        fi
    fi
fi

# ── firewall ──────────────────────────────────────────────────────────
# Only touched once the lockdown has been deliberately enabled, so a routine
# range refresh can never be the thing that first closes ports 80/443.
if [ -x /usr/local/sbin/cloudflare-firewall-sync ] && [ -f /etc/cloudflare/lockdown-enabled ]; then
    log "syncing firewall to refreshed ranges"
    /usr/local/sbin/cloudflare-firewall-sync || log "WARN firewall sync failed"
fi

log "done"
